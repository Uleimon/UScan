<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AssemblyName>UScan</AssemblyName>
    <RootNamespace>UScan.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF code-behind and view models are internal by design; CA1515 would only add noise. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- WPF text layout needs real culture data (XmlLanguage.GetSpecificCulture throws in invariant mode). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UScan.Core/UScan.Core.csproj" />
    <ProjectReference Include="../UScan.Windows/UScan.Windows.csproj" />
    <InternalsVisibleTo Include="UScan.Windows.Tests" />
  </ItemGroup>
</Project>

<Window x:Class="UScan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UScan.Desktop.ViewModels"
        xmlns:local="clr-namespace:UScan.Desktop"
        Title="UScan" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <local:ResourceKeyToBrushConverter x:Key="KeyToBrush"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <local:EqualsConverter x:Key="Eq"/>

        <!-- Big scan tiles: icon, title, one line what it covers. -->
        <Style x:Key="ScanTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Übersicht -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <Border CornerRadius="12" Padding="24,20" Margin="0,0,0,16"
                            Background="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="White" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateText}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="White"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CheckedAt}" Foreground="White" Opacity="0.8" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Scan-Engine"/>
                            <TextBlock Grid.Column="1" Text="{Binding Engine}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Signaturen"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Signatures}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Echtzeitschutz"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnAccess}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Dateiüberwachung"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Monitor}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Quarantäne"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Quarantine}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Letzter Scan"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastScan}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Offene Funde" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding OpenSummary}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,6,4" Background="{DynamicResource DangerBrush}"><TextBlock Foreground="White" FontWeight="SemiBold" Text="Rot: ernst, von ClamAV/Defender erkannt – entfernen"/></Border>
                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,6,4" Background="{DynamicResource MinorBrush}"><TextBlock Foreground="{DynamicResource OnMinorBrush}" FontWeight="SemiBold" Text="Gelb: nur Verdacht (Heuristik), nicht so schlimm – prüfen"/></Border>
                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,6,4" Background="{DynamicResource InfoBrush}"><TextBlock Foreground="White" FontWeight="SemiBold" Text="Blau: von dir als Fehlalarm zugelassen"/></Border>
                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,6,4" Background="{DynamicResource OkBrush}"><TextBlock Foreground="White" FontWeight="SemiBold" Text="Grün: okay"/></Border>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding OpenDetections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding CategoryBrushKey, Converter={StaticResource KeyToBrush}}">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" Foreground="{Binding CategoryTextBrushKey, Converter={StaticResource KeyToBrush}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <WrapPanel>
                                                <Button Content="In Quarantäne" Command="{Binding DataContext.QuarantineDetectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Content="Als Fehlalarm zulassen" Command="{Binding DataContext.AllowDetectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Text="Ein Fund gilt als offen, solange die Datei unverändert am Fundort liegt und weder in Quarantäne verschoben noch als Fehlalarm zugelassen wurde."/>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button Content="Status aktualisieren" Command="{Binding RefreshCommand}"/>
                        <Button Content="Signaturen aktualisieren" Command="{Binding UpdateSignaturesCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Hint}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Scannen -->
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Scannen"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ScanTile}" Command="{Binding QuickCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Schnellscan" FontSize="16" FontWeight="Bold" Margin="0,8,0,2"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Desktop, Downloads, Temp, AppData und alle Autostart-Programme"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ScanTile}" Command="{Binding FullCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Vollständiger Scan" FontSize="16" FontWeight="Bold" Margin="0,8,0,2"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Alle festen Laufwerke; lässt sich pausieren und später fortsetzen"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ScanTile}" Command="{Binding AutostartCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Autostart-Scan" FontSize="16" FontWeight="Bold" Margin="0,8,0,2"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Nur Programme aus Autostart, Diensten und geplanten Aufgaben"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ScanTile}" Command="{Binding FolderCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Ordner scannen …" FontSize="16" FontWeight="Bold" Margin="0,8,0,2"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0" Text="Einen Ordner deiner Wahl prüfen"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                        <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/>
                        <Button Content="Abbrechen" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                    <Border Visibility="{Binding HasInterrupted, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ActionBrush}" BorderThickness="2" CornerRadius="10" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding InterruptedText}" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Scan fortsetzen" Command="{Binding ResumeCommand}" Style="{StaticResource Primary}"/>
                                <Button Content="Verwerfen (Teilbericht speichern)" Command="{Binding DiscardCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,4,0,8">
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressUnknown, Mode=OneWay}" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Ein Prozentwert erscheint erst, wenn alle Dateien gezählt sind."/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding Notes}" Style="{StaticResource Hint}"/>
                <ListView Grid.Row="3" ItemsSource="{Binding Results}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanQuarantine}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Einstufung" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding CategoryBrushKey, Converter={StaticResource KeyToBrush}}">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" Foreground="{Binding CategoryTextBrushKey, Converter={StaticResource KeyToBrush}}"/>
                                                </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Ergebnis" Width="130" DisplayMemberBinding="{Binding VerdictText}"/>
                            <GridViewColumn Header="Datei" Width="380" DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Fund / Grund" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding Explanation}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Aktion" Width="200" DisplayMemberBinding="{Binding Action}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Summary}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Ausgewählte in Quarantäne verschieben" Command="{Binding QuarantineCommand}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="„Verdächtig“ stammt aus der Heuristik und kann ein Fehlalarm sein. Die Begründung steht im Tooltip der Spalte „Fund / Grund“."/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Quarantäne -->
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="Quarantäne"/>
                <ListView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Datum" Width="140" DisplayMemberBinding="{Binding QuarantinedAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                            <GridViewColumn Header="Ursprünglicher Pfad" Width="400" DisplayMemberBinding="{Binding OriginalPath}"/>
                            <GridViewColumn Header="Fund" Width="220" DisplayMemberBinding="{Binding DetectionName}"/>
                            <GridViewColumn Header="Zustand" Width="160" DisplayMemberBinding="{Binding State}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="Wiederherstellen …" Command="{Binding RestoreCommand}"/>
                        <Button Content="Unversehrtheit prüfen" Command="{Binding VerifyCommand}"/>
                        <Button Content="Endgültig löschen …" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Dateien in Quarantäne sind verschlüsselt (AES-256-GCM) und können nicht ausgeführt werden. Zustand „OriginalNotRemoved“ bedeutet: Die Kopie liegt in der Quarantäne, das Original ist aber noch vorhanden."/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Autostart -->
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Autostart, Dienste, geplante Aufgaben"/>
                    <WrapPanel>
                        <Button Content="Alle Einträge anzeigen" Command="{Binding LoadCommand}"/>
                        <Button Content="Änderungen seit letzter Prüfung" Command="{Binding ChangesCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Hint}"/>
                <ListView Grid.Row="2" ItemsSource="{Binding Entries}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Änderung" Width="80" DisplayMemberBinding="{Binding Change}"/>
                            <GridViewColumn Header="Art" Width="150" DisplayMemberBinding="{Binding Kind}"/>
                            <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Datei" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding File}" ToolTip="{Binding Command}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Vorhanden" Width="80" DisplayMemberBinding="{Binding Exists}"/>
                            <GridViewColumn Header="Signatur" Width="220" DisplayMemberBinding="{Binding Signature}"/>
                            <GridViewColumn Header="Beobachtungen" Width="300" DisplayMemberBinding="{Binding Observations}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- Überwachung -->
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Dateiüberwachung"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Neue und geänderte Dateien in diesen Ordnern werden kurz nach der Änderung gescannt. UScan blockiert keine Zugriffe: Eine Datei kann geöffnet werden, bevor der Scan fertig ist. Blockierenden Echtzeitschutz liefert Microsoft Defender, den UScan nie abschaltet."/>
                    <TextBlock Text="Ordner (einer pro Zeile):" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding Folders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="Starten" Command="{Binding StartCommand}"/>
                    <Button Content="Beenden" Command="{Binding StopCommand}"/>
                </WrapPanel>
                <TextBlock Grid.Row="2" Text="{Binding State}" Margin="0,0,0,8"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding Events}"/>
            </Grid>
        </DataTemplate>

        <!-- Protokoll -->
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Heading}" Text="Protokoll"/>
                    <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="16,0,0,12" VerticalAlignment="Top"/>
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding Events}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Zeit" Width="150" DisplayMemberBinding="{Binding Time, StringFormat='dd.MM.yyyy HH:mm:ss'}"/>
                            <GridViewColumn Header="Stufe" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{Binding ColorBrushKey, Converter={StaticResource KeyToBrush}}">
                                                    <TextBlock Text="{Binding ColorLabel}" FontWeight="SemiBold" Foreground="{Binding ColorTextBrushKey, Converter={StaticResource KeyToBrush}}"/>
                                                </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Bereich" Width="100" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Meldung" Width="420" DisplayMemberBinding="{Binding Message}"/>
                            <GridViewColumn Header="Pfad" Width="300" DisplayMemberBinding="{Binding Path}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- Info -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding Version, StringFormat='UScan {0}'}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataFolder, StringFormat='Datenordner: {0}'}"/>
                            <TextBlock Text="{Binding SettingsFile, StringFormat='Einstellungen: {0}'}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Alle Analysen laufen lokal. UScan überträgt keine Dateien und sendet keine Telemetrie. Nur freshclam lädt Signaturen von den offiziellen ClamAV-Servern."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Was UScan kann" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="• Dateien, Ordner und Archive mit ClamAV scannen (Schnell-, Voll-, Autostart- und Ordner-Scan)"/>
                            <TextBlock Text="• Heuristik für Programme, Skripte und Office-Makros (Ergebnis höchstens „verdächtig“, mit Begründung)"/>
                            <TextBlock Text="• Zweitmeinung durch Microsoft Defender bei Funden (ohne dass Defender etwas verändert)"/>
                            <TextBlock Text="• Verschlüsselte Quarantäne mit sicherer Wiederherstellung"/>
                            <TextBlock Text="• Autostart, Dienste und geplante Aufgaben mit Signaturprüfung anzeigen und Änderungen erkennen"/>
                            <TextBlock Text="• Geänderte Dateien in gewählten Ordnern nachscannen"/>
                            <TextBlock Text="Was UScan nicht kann" FontWeight="SemiBold" Margin="0,12,0,6"/>
                            <TextBlock Text="• Kein blockierender Echtzeitschutz (kein eigener Kernel-Treiber); dafür bleibt Microsoft Defender zuständig"/>
                            <TextBlock Text="• Kein Speicher-Scan laufender Prozesse, kein Boot-/Offline-Scan, kein Rootkit-Scan"/>
                            <TextBlock Text="• Kein Web- oder E-Mail-Schutz, keine Cloud-Analyse"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Hell / Dunkel umschalten" HorizontalAlignment="Left" Click="ToggleTheme"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="{DynamicResource NavBrush}">
            <DockPanel Margin="8,14">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="UScan" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton Style="{StaticResource NavItem}" Content="Protokoll" Tag="&#xE81C;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=log}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Info" Tag="&#xE946;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=about}"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Übersicht" Tag="&#xE80F;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=dashboard}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Scannen" Tag="&#xE721;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=scan}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Quarantäne" Tag="&#xE72E;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=quarantine}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Autostart" Tag="&#xE7E8;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=inventory}"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Überwachung" Tag="&#xE890;"
                                 IsChecked="{Binding PageKey, Converter={StaticResource Eq}, ConverterParameter=monitor}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding Page}" Focusable="False"/>

        <!-- Status bar: a running scan stays visible (and can be paused or stopped) on every page. -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource NavBrush}" Padding="16,8"
                Visibility="{Binding Scan.Running, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Abbrechen" Command="{Binding Scan.CancelCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="{Binding Scan.PauseLabel}" Command="{Binding Scan.PauseCommand}" Margin="8,0,0,0"/>
                <ProgressBar DockPanel.Dock="Right" Width="220" Minimum="0" Maximum="100" Value="{Binding Scan.Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding Scan.ProgressUnknown, Mode=OneWay}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="Scan läuft"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Scan.ProgressText}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

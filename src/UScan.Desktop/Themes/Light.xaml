<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="NavBrush" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#DCDFE5"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#261D4ED8"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#0891B2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="OnDangerSoftBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="OkBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="ActionBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="MinorBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="OnMinorBrush" Color="#1F1600"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#4B5563"/>
</ResourceDictionary>

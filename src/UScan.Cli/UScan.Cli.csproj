<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>uscan</AssemblyName>
    <!-- net10.0-windows adds the Windows modules (Authenticode, inventory, Defender); net10.0 runs anywhere for development and CI. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UScan.Core\UScan.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\UScan.Windows\UScan.Windows.csproj" />
  </ItemGroup>

</Project>
